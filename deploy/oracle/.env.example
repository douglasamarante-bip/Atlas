# Copie para .env e preencha. NUNCA envie o .env para o GitHub.
ATLAS_ACCESS_CODE=troque-por-um-codigo-seu
META_COUNTRY=BR
GOOGLE_REGION=BR
# Endereço do seu site no Netlify (restringe quem pode chamar o coletor pelo navegador)
ALLOW_ORIGIN=https://SEU-SITE.netlify.app
# Proxy (só se a Meta/Google bloquearem o servidor): http://usuario:senha@host:porta
# PROXY_URL=
# Túnel fixo da Cloudflare (opcional, veja o LEIAME):
# TUNNEL_CMD=tunnel --no-autoupdate run
# TUNNEL_TOKEN=
